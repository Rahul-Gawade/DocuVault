# DocuVault Server Environment Configuration

# Server Port
PORT=5000

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/docuvault?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Cloudinary Storage Configuration (Optional - falls back to local disk storage if blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Service (SMTP) Configuration (Optional - logs to console in dev mode if blank)
CLIENT_URL=http://localhost:5174
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DocuVault <no-reply@docuvault.io>"
